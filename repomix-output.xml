                                ? kDevueltoBgColor
                                : Color(0xFFE0F2F1),
                            borderRadius: BorderRadius.circular(8),
                            border: Border.all(
                              color: esDevuelto
                                  ? kDevueltoColor
                                  : kAccentColor,
                            ),
                          ),
                          child: Row(
                            mainAxisSize: MainAxisSize.min,
                            children: [
                              Icon(
                                esDevuelto
                                    ? Icons.check_circle
                                    : Icons.schedule,
                                size: 12,
                                color: esDevuelto
                                    ? kDevueltoColor
                                    : kAccentColor,
                              ),
                              SizedBox(width: 4),
                              Text(
